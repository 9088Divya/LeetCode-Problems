class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int cur=0;
        int max_till=INT_MIN;
        for(int i=0;i<nums.size();i++)
        {
            cur=max(nums[i],cur+nums[i]);
            max_till=max(max_till,cur);

        }
        return max_till;
        
    }
};
